.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #9B59B6 0%, #FF6B9D 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

.game-header {
  text-align: center;
  padding: 40rpx 0;
}

.game-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
}

.player-section {
  text-align: center;
  padding: 40rpx 0;
}

.player-avatar {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin: 0 auto 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2);
}

.player-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.player-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.question-section {
  padding: 40rpx 0;
}

.question-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.15);
}

.question {
  font-size: 36rpx;
  color: #333;
  text-align: center;
  line-height: 1.8;
}

.action-section {
  padding: 40rpx 0;
}

.action-btn {
  width: 100%;
  padding: 36rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #C44569 100%);
  border-radius: 20rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(200, 69, 105, 0.4);
}

.action-btn.secondary {
  background: rgba(255,255,255,0.9);
  color: #9B59B6;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.result-section {
  text-align: center;
  padding: 40rpx 0;
}

.result-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.result-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 32rpx;
}

.back-btn {
  text-align: center;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  padding: 20rpx;
}