.page {
  min-height: 100vh;
  background: #F5F3FF;
}

/* 顶部渐变 */
.header {
  background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);
  padding: 60rpx 30rpx 50rpx;
  text-align: center;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 36rpx;
}

.btn-create {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: white;
  color: #7C3AED;
  border: none;
  border-radius: 40rpx;
  padding: 22rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.btn-create:active {
  transform: scale(0.95);
}

.btn-create-icon {
  font-size: 36rpx;
}

/* 搜索框 */
.search-bar {
  margin: -20rpx 20rpx 20rpx;
  background: white;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(124, 58, 237, 0.08);
  position: relative;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 48rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 85%;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.max-players-bar {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.player-option {
  padding: 12rpx 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.player-option.selected {
  border-color: #7C3AED;
  background: #F5F3FF;
  color: #7C3AED;
  font-weight: bold;
}

.btn-full {
  width: 100%;
  margin-top: 10rpx;
}

/* 房间列表 */
.room-list-section {
  padding: 0 20rpx 120rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 80rpx;
  background: white;
  border-radius: 20rpx;
}

.empty-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 房间卡片 */
.room-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(124, 58, 237, 0.06);
}

.room-card:active {
  background: #FAF5FF;
}

.room-card-left {
  display: flex;
  align-items: center;
  flex: 1;
  margin-right: 16rpx;
}

.room-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #F5F3FF 0%, #EDE9FE 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.room-card-info {
  flex: 1;
}

.room-card-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.room-card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.lock-icon {
  font-size: 24rpx;
}

.room-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.room-tag.waiting {
  background: #DCFCE7;
  color: #16A34A;
}

.room-tag.ended {
  background: #FEE2E2;
  color: #DC2626;
}

.room-card-host {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

/* 人数进度条 */
.player-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.player-bar-bg {
  flex: 1;
  height: 12rpx;
  background: #F3F4F6;
  border-radius: 6rpx;
  overflow: hidden;
}

.player-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7C3AED, #A78BFA);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.player-bar-text {
  font-size: 22rpx;
  color: #7C3AED;
  font-weight: bold;
  white-space: nowrap;
}

.room-card-right {
  background: linear-gradient(135deg, #7C3AED 0%, #6D28D9 100%);
  border-radius: 24rpx;
  padding: 16rpx 28rpx;
  flex-shrink: 0;
}

.join-btn-text {
  color: white;
  font-size: 26rpx;
  font-weight: bold;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #7C3AED;
}

.no-more {
  color: #999;
}