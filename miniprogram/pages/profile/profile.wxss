.page {
  min-height: 100vh;
  background: #F5F3FF;
  padding-bottom: 120rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: white;
  font-weight: bold;
}

.user-info { flex: 1; }

.user-name {
  font-size: 34rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 统计 */
.stats-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 0 20rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(124, 58, 237, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #F5F3FF;
  border-radius: 16rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #7C3AED;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stats-extra {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.stat-extra-item {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 20rpx;
  background: linear-gradient(135deg, #F5F3FF 0%, #EDE9FE 100%);
  border-radius: 12rpx;
}

.stat-extra-label { font-size: 26rpx; color: #666; }
.stat-extra-value { font-size: 28rpx; font-weight: bold; color: #7C3AED; }

/* 7天趋势 */
.trend-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 0 20rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(124, 58, 237, 0.06);
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 200rpx;
  padding-top: 20rpx;
}

.trend-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}

.trend-bar-bg {
  width: 100%;
  height: 120rpx;
  background: #F3F4F6;
  border-radius: 8rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.trend-bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #7C3AED, #A78BFA);
  border-radius: 8rpx;
  min-height: 4rpx;
  transition: height 0.5s;
}

.trend-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
}

.trend-count {
  font-size: 22rpx;
  font-weight: bold;
  color: #7C3AED;
  margin-top: 4rpx;
}

/* 历史记录 */
.history-section {
  padding: 0 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-count { font-size: 24rpx; color: #999; }

.empty-state {
  text-align: center;
  padding: 60rpx;
  background: white;
  border-radius: 20rpx;
}

.empty-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #999; display: block; margin-bottom: 24rpx; }

.btn-primary.small {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  display: inline-block;
}

.history-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(124, 58, 237, 0.06);
}

.history-info { flex: 1; margin-right: 16rpx; }

.room-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.question-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.question-type { font-size: 24rpx; }

.question-text {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-time { font-size: 22rpx; color: #999; }

.history-status { flex-shrink: 0; }

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.status-tag.truth { background: #EDE9FE; color: #7C3AED; }
.status-tag.dare { background: #FEF3C7; color: #D97706; }

/* 菜单 */
.menu-section {
  background: white;
  border-radius: 20rpx;
  margin: 16rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(124, 58, 237, 0.06);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon { font-size: 36rpx; margin-right: 16rpx; }
.menu-text { flex: 1; font-size: 28rpx; color: #333; }
.menu-arrow { font-size: 32rpx; color: #CCC; }

.btn-primary {
  background: linear-gradient(135deg, #7C3AED 0%, #6D28D9 100%);
  color: white;
  border: none;
  border-radius: 32rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}