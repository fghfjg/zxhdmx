.container {
  min-height: 100vh;
  background: #F8F0F5;
  padding: 32rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.stats-section,
.ranking-section,
.history-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  background: linear-gradient(135deg, #FCE4EC 0%, #F8BBD9 100%);
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #880E4F;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #880E4F;
}

.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.rank-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.player-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.player-avatar {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #9B59B6 0%, #FF6B9D 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.player-details {
  flex: 1;
}

.player-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.player-stats {
  font-size: 22rpx;
  color: #999;
}

.player-score {
  font-size: 32rpx;
  font-weight: bold;
  color: #9B59B6;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  display: flex;
  gap: 16rpx;
}

.type-badge {
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.type-badge.truth {
  background: #E3F2FD;
  color: #1976D2;
}

.type-badge.dare {
  background: #E8F5E9;
  color: #388E3C;
}

.history-content {
  flex: 1;
}

.history-question {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.history-meta {
  display: flex;
  gap: 16rpx;
}

.history-player {
  font-size: 24rpx;
  color: #9B59B6;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}

.back-btn {
  position: fixed;
  bottom: 32rpx;
  left: 32rpx;
  right: 32rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #9B59B6 0%, #FF6B9D 100%);
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(155, 89, 182, 0.4);
}