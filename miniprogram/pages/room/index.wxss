.container {
  min-height: 100vh;
  background: #F8F0F5;
  padding: 32rpx;
  box-sizing: border-box;
}

.room-header {
  background: linear-gradient(135deg, #9B59B6 0%, #FF6B9D 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.room-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.room-id {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.players-section,
.game-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.player-count {
  font-size: 26rpx;
  color: #9B59B6;
}

.player-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.player-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.player-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #9B59B6 0%, #FF6B9D 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.player-info {
  flex: 1;
}

.player-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.host-tag {
  font-size: 20rpx;
  color: #FF6B9D;
  background: #FFE4EC;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.player-status {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.player-status.online {
  color: #388E3C;
}

.player-status.away {
  color: #FF9800;
}

.kick-btn {
  font-size: 24rpx;
  color: #E53935;
  padding: 8rpx 20rpx;
  border: 1rpx solid #E53935;
  border-radius: 20rpx;
}

.game-controls {
  text-align: center;
}

.game-btn {
  padding: 32rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.game-btn.start {
  background: linear-gradient(135deg, #FF6B9D 0%, #C44569 100%);
  color: #fff;
}

.game-btn.end {
  background: #f5f5f5;
  color: #666;
}

.current-turn {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.turn-label {
  font-size: 26rpx;
  color: #FF9800;
  display: block;
  margin-bottom: 12rpx;
}

.turn-player {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.turn-player .avatar {
  font-size: 48rpx;
}

.turn-player .name {
  font-size: 32rpx;
  font-weight: bold;
  color: #E65100;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  padding: 32rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.action-btn.truth {
  background: linear-gradient(135deg, #64B5F6 0%, #1E88E5 100%);
  color: #fff;
}

.action-btn.dare {
  background: linear-gradient(135deg, #66BB6A 0%, #388E3C 100%);
  color: #fff;
}

.nav-section {
  display: flex;
  gap: 24rpx;
}

.nav-btn {
  flex: 1;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 48rpx 32rpx;
}

.question-card {
  background: linear-gradient(135deg, #FCE4EC 0%, #F8BBD9 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
}

.question {
  font-size: 32rpx;
  color: #880E4F;
  line-height: 1.6;
}

.modal-footer {
  padding: 24rpx 32rpx 32rpx;
}

.modal-btn.confirm {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #9B59B6 0%, #FF6B9D 100%);
  color: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}